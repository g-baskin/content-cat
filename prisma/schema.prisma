generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model GeneratedImage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  url              String
  prompt           String
  aspectRatio      String   @map("aspect_ratio")
  generator        String   @default("fal") // "fal" or "midjourney"
  generatorModel   String   @default("nano-banana-pro") @map("generator_model") // specific model used
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([generator])
  @@map("generated_images")
}

model ApiKey {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  key       String
  service   String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
  @@index([userId])
  @@map("api_keys")
}

model Character {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  referenceImages String[] @map("reference_images")
  thumbnailUrl    String?  @map("thumbnail_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("characters")
}

model Product {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  referenceImages String[] @map("reference_images")
  thumbnailUrl    String?  @map("thumbnail_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("products")
}

model GeneratedVideo {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  url           String
  thumbnailUrl  String?  @map("thumbnail_url")
  prompt        String
  model         String
  duration      Int
  aspectRatio   String   @map("aspect_ratio")
  resolution    String?
  startImageUrl String?  @map("start_image_url")
  endImageUrl   String?  @map("end_image_url")
  audioEnabled  Boolean  @default(false) @map("audio_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  storyboard Storyboard? // Back-relation for finalVideo

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("generated_videos")
}

model Workflow {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @default("Untitled Workflow")
  nodes     Json     @default("[]")
  edges     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("workflows")
}

model Storyboard {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String   @default("Untitled Storyboard")
  description  String?
  status       String   @default("draft") // draft, generating, complete, failed
  totalDuration Int     @default(0) @map("total_duration") // calculated from scenes
  aspectRatio  String   @default("16:9") @map("aspect_ratio")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Final stitched video
  finalVideoId  String?         @unique @map("final_video_id")
  finalVideo    GeneratedVideo? @relation(fields: [finalVideoId], references: [id])

  scenes Scene[]
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status])
  @@map("storyboards")
}

model Scene {
  id           String   @id @default(uuid())
  storyboardId String   @map("storyboard_id")
  order        Int      // Scene order in storyboard (0-indexed)
  name         String?  // Optional scene name
  prompt       String
  duration     Int      @default(5) // seconds
  aspectRatio  String   @default("16:9") @map("aspect_ratio")
  service      String   @default("fal") // fal, openai, runway, pika, luma
  model        String   @default("kling-2.6") // specific model to use

  // Generation state
  status       String   @default("pending") // pending, generating, complete, failed
  videoUrl     String?  @map("video_url")
  thumbnailUrl String?  @map("thumbnail_url")
  error        String?

  // Video generation options
  negativePrompt String? @map("negative_prompt")
  seed           Int?
  cfgScale       Float?  @default(0.5) @map("cfg_scale")
  enableAudio    Boolean @default(false) @map("enable_audio")

  // Reference images for image-to-video
  startImageUrl String? @map("start_image_url")
  endImageUrl   String? @map("end_image_url")

  // Transition to next scene
  transition         String? @default("cut") // cut, fade, dissolve, wipe
  transitionDuration Float?  @default(0.5) @map("transition_duration") // seconds

  // Dialogue/TTS
  dialogueText  String? @map("dialogue_text")
  dialogueVoice String? @map("dialogue_voice") // Voice ID for TTS
  dialogueUrl   String? @map("dialogue_url")   // Generated TTS audio URL

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  storyboard Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@index([storyboardId])
  @@index([storyboardId, order])
  @@index([status])
  @@map("scenes")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String?
  role         String    @default("user") // "admin" or "user"
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  generatedImages GeneratedImage[]
  apiKeys         ApiKey[]
  characters      Character[]
  products        Product[]
  generatedVideos GeneratedVideo[]
  workflows       Workflow[]
  storyboards     Storyboard[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
